{
  "name": "eslint-plugin-strictlock",
  "version": "0.2.0",
  "description": "StrictLock's ESLint plugin: structural gates against false-safety-net tests (e.g. smoke-only assertions).",
  "license": "Apache-2.0",
  "author": {
    "name": "Tim Downs Mullen",
    "url": "https://downsmullen.com"
  },
  "type": "module",
  "main": "./index.cjs",
  "exports": {
    ".": {
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "index.cjs",
    "rules/_shared.cjs",
    "rules/_shared.mjs",
    "rules/no-smoke-only-assertions.cjs",
    "rules/no-smoke-only-assertions.mjs",
    "rules/no-tautological-assertions.cjs",
    "rules/no-tautological-assertions.mjs",
    "rules/no-unasserted-result.cjs",
    "rules/no-unasserted-result.mjs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "testing",
    "test-quality",
    "smoke-tests",
    "strictlock"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TDM-Technologies/strictlock.git",
    "directory": "eslint-plugin-strictlock"
  },
  "homepage": "https://github.com/TDM-Technologies/strictlock/tree/main/eslint-plugin-strictlock#readme",
  "bugs": {
    "url": "https://github.com/TDM-Technologies/strictlock/issues"
  },
  "peerDependencies": {
    "eslint": ">=8"
  },
  "devDependencies": {
    "eslint": ">=8"
  },
  "engines": {
    "node": ">=18"
  }
}
